<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Lyra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.Lyra.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_lyra_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Lyra</item>
    </style>
</resources>
